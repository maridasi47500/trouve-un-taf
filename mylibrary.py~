class ScanJobOffers:
    def __init__(self):
        print("Welcome to my job search")
    def scanjobijoba(self, myhash):
    
        myscan={"title": "", "content":"", "company":"", "city":"", "jobofferurl": "jobijoba","salaire":""}
        myscans=[]
        soup = BeautifulSoup(myhash["body"], "html.parser")
        secure_links = soup.select('a[href*="emails.jobijoba.com"]')
        for x in secure_links:
            myscan={"title": "", "content":"", "company":"", "city":"", "jobofferurl": "jobijoba", "salaire":""}
            try:
                mylink=BeautifulSoup(str(x), "html.parser")
                title=mylink.select("strong span")
                info=mylink.select("p span")
                print("mytitle", (title))
                for w in title:
                    print("title", w.get("title"))
                    print("company", info[1].get_text())
                    print("city", info[2].get_text())
                    #print("contrat", info[3].get_text())
                    #print("hybrid", info[4].get_text())
                    #print("description", info[5].get_text())
                    myscan["title"]= w.get("title")
                    myscan["company"]= info[1].get_text()
                    myscan["city"]= info[2].get_text()
                    if len(info) > 4:
                        for aa in info[3:]:
                            text=aa.get_text().lower()
                            numbers = re.findall(r'-?\d*\.?\d+', text)
                            if "€" in text and len(numbers) > 0:
                                myscan["salaire"]= text
                            elif "cdd" in text or "cdi" in text or "indépendant" in text or "stage" in text or "interim" in text or "intérim" in text:
                                myscan["contrat"]= text
                            elif "télétravail" in text or "teletravail" in text or "hybrid" in text or "presentiel" in text or "présentiel" in text:
                                myscan["hybrid"]= text
                    content= info[-1].get_text().strip()
                    if content.strip().lower() == "sponsorisé":
                        content= info[-2].get_text().strip()

                    myscan["content"]= content
                    myscans.append(myscan)
            except Exception as e:
                print("error", e)
                 
        
        
        print(myscans)
        return myscans
    
