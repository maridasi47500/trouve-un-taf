                        print("how are you salaire / contrat plein temps temps partial", salaire)
                        monsalaire=salaire[0][0].strip()
                        contrat=salaire[0][1].strip()

                        myscan["salaire"]= monsalaire
                        myscan["contrat"]= contrat
                infocompany=tout1.select("[bgcolor='#E8F2FF']")[0].get_text()
                company+=" "+infocompany
                myscan["company"]= company
                try:
                    infooffer=tout1.select("[bgcolor='#F1FFA1']")[0].get_text()
                    myscan["content"]= infooffer
                except:
                    print("error")
                myscans.append(myscan)
            except Exception as e:
                print("error Jobs leads", e)
                 
        
        
        print(myscans)
        return myscans
    
    def scanjobijoba(self, myhash):
    
