{%extends "base.html"%} 
{% block content %}


<p>
tu veux regarder toutes les offres d'emploi qui viennent de tes alertes sur :
indeed, linkedin, welcome to the jungle, hello work, apec, cadremploi, meteojob, jobleads, jobijoba, jooble
</p>
<form>
<div>
<label>
combien d'emails veux tu regarder en partant du haut de tes emails des plus récents aux plus anciens  pour trouver toutes les emails des newsletter d'alerte de recherche d'emploi ?
</label>
<input value="{{ nbemails }}" name="nbemail"/>
</div>
<input type="submit" value="envoyer"/>

</form>
<h2> emails pour <span style="display:none;" id="myemailstr">{{ username }}</span> <span id="adressemasque">(******@******.*** adresse masquée )<a href="" onclick="adressemasque.style.display='none';myemailstr.style.display='inline-block';return false;" onclick="return false;">montrer l'adresse</a></span></h2>
{% for x in emails %}

<li>

<a target="_blank" href="/email?from={{ username }}&subject={{ x["name"] }}">{{ x["from"] }}(subject : <i>{{ x["subject"] }}</i>, date : <i>{{ x["date"] }}</i>)</a>
{{x["body"]}}

</li>

{% endfor%}

  {% endblock %}
